{
  "name": "sol500",
  "productName": "SOL 500",
  "version": "3.6.0",
  "private": true,
  "description": "SOL 500: run a Mars outpost for 500 sols. Real NASA numbers, English and Vietnamese, co-op for up to 5 players, with an admin panel.",
  "author": "Tung Son",
  "main": "app/main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "app:dev": "electron .",
    "smoke": "node tools/app-smoke.js",
    "progress": "node tools/progress.js",
    "app": "npm run progress && electron-builder --win nsis"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sol500.marsoutpost",
    "productName": "SOL 500",
    "copyright": "Copyright © 2026 Tung Son",
    "artifactName": "SOL500-Setup-${version}.${ext}",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "app/**",
      "lib/**",
      "src/**",
      "icons/**",
      "server.js",
      "index.html",
      "admin.html",
      "progress.json",
      "manifest.webmanifest",
      "sw.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico",
      "publisherName": "Tung Son"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SOL 500"
    }
  }
}
